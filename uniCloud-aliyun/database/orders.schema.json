// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
{
	"bsonType": "object",
	"required": ["orderNo", "userId", "storeId", "barberId", "serviceId", "date", "startTime", "endTime", "status", "verifyCode"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"indexes": [
		{
			"key": {
				"userId": 1,
				"updatedAt": -1
			},
			"name": "idx_orders_user_updated"
		},
		{
			"key": {
				"storeId": 1,
				"date": 1,
				"updatedAt": -1
			},
			"name": "idx_orders_store_date_updated"
		},
		{
			"key": {
				"barberId": 1,
				"date": 1,
				"status": 1
			},
			"name": "idx_orders_barber_date_status"
		},
		{
			"key": {
				"verifyCode": 1
			},
			"name": "idx_orders_verify_code"
		}
	],
		"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"orderNo": {
			"bsonType": "string",
			"description": "订单号"
		},
		"userId": {
			"bsonType": "string",
			"description": "用户ID"
		},
		"storeId": {
			"bsonType": "string",
			"description": "门店ID"
		},
		"storeName": {
			"bsonType": "string",
			"description": "门店名称快照"
		},
		"barberId": {
			"bsonType": "string",
			"description": "理发师ID"
		},
		"barberName": {
			"bsonType": "string",
			"description": "理发师名称快照"
		},
		"serviceId": {
			"bsonType": "string",
			"description": "服务ID"
		},
		"serviceName": {
			"bsonType": "string",
			"description": "服务名称快照"
		},
		"price": {
			"bsonType": "number",
			"description": "订单价格"
		},
		"date": {
			"bsonType": "string",
			"description": "预约日期"
		},
		"startTime": {
			"bsonType": "string",
			"description": "开始时间"
		},
		"endTime": {
			"bsonType": "string",
			"description": "结束时间"
		},
		"status": {
			"bsonType": "string",
			"description": "订单状态（BOOKED/ARRIVED/IN_SERVICE/FINISHED/CANCELLED/NO_SHOW）"
		},
		"verifyCode": {
			"bsonType": "string",
			"description": "核验码"
		},
		"remark": {
			"bsonType": "string",
			"description": "备注"
		},
		"cancelReason": {
			"bsonType": "string",
			"description": "取消原因（预留）"
		},
		"rescheduleFrom": {
			"bsonType": "string",
			"description": "改期来源订单ID（预留）"
		},
		"arrivedAt": {
			"bsonType": "int",
			"description": "到店时间戳"
		},
		"verifiedBy": {
			"bsonType": "string",
			"description": "核验人员ID"
		},
		"inServiceAt": {
			"bsonType": "int",
			"description": "开始服务时间戳"
		},
		"finishedAt": {
			"bsonType": "int",
			"description": "完成服务时间戳"
		},
		"noShowAt": {
			"bsonType": "int",
			"description": "爽约时间戳"
		},
			"noShowReason": {
				"bsonType": "string",
				"description": "爽约原因"
			},
			"autoCancelledAt": {
				"bsonType": "int",
				"description": "自动超时处理时间戳（兼容历史字段）"
			},
			"deletedByUser": {
				"bsonType": "bool",
				"description": "用户侧逻辑删除标记"
			},
			"deletedByUserAt": {
				"bsonType": "int",
				"description": "用户侧逻辑删除时间戳"
			},
			"deletedByStore": {
				"bsonType": "bool",
				"description": "门店侧逻辑删除标记"
			},
			"deletedByStoreAt": {
				"bsonType": "int",
				"description": "门店侧逻辑删除时间戳"
			},
			"createdAt": {
				"bsonType": "int",
				"description": "创建时间戳"
			},
		"updatedAt": {
			"bsonType": "int",
			"description": "更新时间戳"
		}
	}
}
