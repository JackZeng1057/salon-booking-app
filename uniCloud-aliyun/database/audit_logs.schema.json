// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
{
  "bsonType": "object",
  "required": ["actorId", "role", "action", "time", "result"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "indexes": [
    {
      "key": {
        "orderId": 1,
        "time": -1
      },
      "name": "order_time"
    },
    {
      "key": {
        "actorId": 1,
        "time": -1
      },
      "name": "actor_time"
    }
  ],
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "actorId": {
      "bsonType": "string",
      "description": "操作者ID"
    },
    "role": {
      "bsonType": "string",
      "description": "操作者角色"
    },
    "action": {
      "bsonType": "string",
      "description": "动作"
    },
    "orderId": {
      "bsonType": "string",
      "description": "订单ID"
    },
    "time": {
      "bsonType": "int",
      "description": "操作时间戳"
    },
    "result": {
      "bsonType": "string",
      "description": "结果 success/failed"
    },
    "message": {
      "bsonType": "string",
      "description": "错误信息"
    },
    "requestId": {
      "bsonType": "string",
      "description": "请求ID"
    }
  }
}
